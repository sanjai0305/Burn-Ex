# MySQL Database Connection URL
# Format: mysql+pymysql://username:password@localhost:3306/burnex_db
MYSQL_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/burnex_db

# Firebase Authentication (Project ID)
FIREBASE_PROJECT_ID=burn-x-7200b

# Google Gemini API Settings (Get key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Razorpay Payments Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Optional Cloudinary Configuration for Avatar Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
